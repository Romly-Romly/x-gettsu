{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-Gettsu",
  "mainBinaryName": "XGettsu",
  "version": "1.1.0",
  "identifier": "com.romly.xgettsu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "エックスげっつ",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
